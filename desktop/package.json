{
  "name": "intel-ai-core",
  "version": "1.4.0",
  "private": true,
  "main": "main.cjs",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.intelaicore.desktop",
    "productName": "Intel AI Core",
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CORE-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "CORE-macOS-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
