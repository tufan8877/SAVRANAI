{
  "name": "intel-ai-core-byok",
  "version": "2.2.0",
  "private": true,
  "main": "main.cjs",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.intelaicore.desktop.byok",
    "productName": "Intel AI Core BYOK",
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CORE-BYOK-Windows-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
