{
  "name": "intel-ai-core-test",
  "version": "2.1.0",
  "private": true,
  "main": "main.cjs",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.intelaicore.desktop.test",
    "productName": "Intel AI Core Test",
    "files": [
      "main.cjs",
      "preload.cjs",
      "test-config.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CORE-Test-Windows-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
